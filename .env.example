# ==============================================================================
# PostcodeLink Nigeria — Unified Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Next.js 15)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. Backend Configuration (FastAPI & SQLAlchemy)
# ------------------------------------------------------------------------------
# Database Connection:
# Development (SQLite):
DATABASE_URL=sqlite:///./postcodelink.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://username:password@localhost:5432/postcodelink_prod

# Application Environment (development | staging | production)
# In production, startup refuses to boot if SECRET_KEY is weak or default.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Cryptographic Secrets & Domain Separation
# IMPORTANT: In production, generate authentic 32+ character secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   or: openssl rand -hex 32
# Startup validation strictly blocks known template and example values in production.
# ------------------------------------------------------------------------------
# JWT Authentication Secret (Must be unique, random, and at least 32 characters)
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY_MIN_32_CHARS_DO_NOT_USE_EXAMPLE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_KEY_ID=v1
# Key rotation: During key upgrades, set JWT_KEY_ID=v2 and map prior keys using either:
# Option A (colon-separated kid:secret pairs):
# JWT_PREVIOUS_SECRETS=v1:REPLACE_WITH_PREVIOUS_V1_SECRET_KEY
# Option B (JSON map):
# JWT_PREVIOUS_KEYS_MAP={"v1": "REPLACE_WITH_PREVIOUS_V1_SECRET_KEY"}

# Dedicated Outbox Encryption Key for in-transit PIN encryption (distinct from SECRET_KEY)
OUTBOX_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_OUTBOX_KEY_MIN_32_CHARS_DO_NOT_USE_EXAMPLE

# Dedicated OTP Secret Key for delivery PIN verification (distinct from SECRET_KEY and OUTBOX_ENCRYPTION_KEY)
# In production, OTP_SECRET_KEY is strictly mandatory for cryptographic domain separation.
OTP_SECRET_KEY=REPLACE_WITH_GENERATED_OTP_KEY_MIN_32_CHARS_DO_NOT_USE_EXAMPLE
# Comma-separated list of previous OTP secrets for zero-downtime in-flight delivery rotation
# OTP_PREVIOUS_SECRETS=

# Background Outbox Retry Worker (Must be true in production)
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_INTERVAL_SECONDS=5
OUTBOX_WORKER_HEARTBEAT_THRESHOLD_SECONDS=120

# Redis Cache & Distributed Rate Limiting (Required by default in production for distributed rate limiting)
# REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED_IN_PRODUCTION=true
RATE_LIMIT_REDIS_FAIL_CLOSED=true
ALLOW_IN_MEMORY_RATE_LIMIT_IN_PRODUCTION=false

# Seeding Controls (Demo accounts strictly forbidden in production)
SEED_DEMO_DATA=false
SEED_DEMO_ACCOUNTS=false

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 3. Notification & SMS Gateway Providers
# ------------------------------------------------------------------------------
# Options: "simulated" (default for dev), "termii" (Nigerian networks), "twilio" (Global)
SMS_PROVIDER=simulated

# Termii Configuration (Nigerian Mobile Networks: MTN, Airtel, Glo, 9mobile)
# Required when SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=PostcodeLnk

# Twilio Configuration (Global SMS & WhatsApp Gateway)
# Required when SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# 4. Official NIPOST / Cloud Directory API (Optional)
# ------------------------------------------------------------------------------
# When blank, PostcodeLink falls back to the local pilot reference dataset (11 states; not independently NIPOST-verified).
# Published quickstart defaults: https://api.postcode.gov.ng, X-API-Key header, GET /v1/lookup?code=...
NIPOST_API_BASE_URL=
NIPOST_API_KEY=
NIPOST_AUTH_SCHEME=x-api-key
NIPOST_LOOKUP_PATH=/v1/lookup
# Optional separate Validator route; leave blank for unified /v1/lookup on api.postcode.gov.ng
NIPOST_VALIDATE_PATH=

# Session cookie SameSite policy ('lax' for same-site app/api subdomains; 'none' only for cross-site HTTPS)
SESSION_COOKIE_SAMESITE=lax
